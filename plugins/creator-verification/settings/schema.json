    "description": "Minimum platform follower count required to apply for verification."
  },
  {
    "id": "maxDocumentSizeMB",
    "label": "Max Document Upload Size (MB)",
    "type": "number",
    "defaultValue": 10,
    "min": 1,
    "max": 50
