    "min": 1,
    "max": 720
  },
  {
    "id": "requireGovernmentId",
    "label": "Require Government-Issued ID",
    "type": "toggle",
    "defaultValue": true
  },
  {
    "id": "requireSelfie",
    "label": "Require Selfie with ID",
    "type": "toggle",
    "defaultValue": true,
    "description": "Require a photo of the applicant holding their government ID."
  },
  {
    "id": "requireProofOfAddress",
    "label": "Require Proof of Address",
    "type": "toggle",
    "defaultValue": false
  },
  {
    "id": "requireSocialMediaLink",
    "label": "Require Social Media Profile Link",
    "type": "toggle",
    "defaultValue": true
  },
  {
    "id": "minimumFollowerCount",
    "label": "Minimum Follower Count",
    "type": "number",
    "defaultValue": 0,
    "min": 0,
