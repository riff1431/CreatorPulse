  {
    "id": "allowedDocumentTypes",
    "label": "Allowed Document MIME Types",
    "type": "text",
    "defaultValue": "image/jpeg,image/png,application/pdf",
    "placeholder": "image/jpeg,image/png,application/pdf"
  },
  {
    "id": "notifyOnSubmission",
    "label": "Notify Admin on New Applications",
    "type": "toggle",
    "defaultValue": true
  },
  {
    "id": "notifyOnStatusChange",
    "label": "Notify Creator on Status Changes",
    "type": "toggle",
    "defaultValue": true
  },
  {
    "id": "badgeStyle",
    "label": "Verification Badge Style",
    "type": "select",
    "defaultValue": "standard",
    "options": [
      { "label": "Standard Checkmark", "value": "standard", "description": "Simple verified checkmark icon" },
      { "label": "Premium Shield", "value": "premium", "description": "Gradient shield badge with glow" },
      { "label": "Animated Pulse", "value": "animated", "description": "Subtle breathing pulse animation" }
    ]
  },
  {
    "id": "badgeColor",
    "label": "Badge Accent Color",
    "type": "color",
    "defaultValue": "#10B981"
  },
  {
    "id": "verificationExpiryDays",
    "label": "Verification Expiry (Days)",
    "type": "number",
